<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:label="@string/app_label"
        android:supportsRtl="true"
        android:theme="@style/Theme.FakeChats">
        <activity
            android:name=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".InboxActivity" android:exported="true" />
        <activity
            android:name=".SearchActivity"
            android:exported="true"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity
            android:name=".ConversationActivity"
            android:exported="true"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity android:name=".DeckActivity" android:exported="true" />
        <activity android:name=".MatchesActivity" android:exported="true" />
        <activity android:name=".SecureFolderActivity" android:exported="true" />
        <activity
            android:name=".ClearLogActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
