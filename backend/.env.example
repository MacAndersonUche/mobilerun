# Mobilerun Backend Configuration
ALLOW_UNAUTHENTICATED=true
JWT_SECRET=dev-secret-change-in-production

# LLM Provider API Keys (add at least one)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# xAI Grok — OpenAI-compatible at https://api.x.ai/v1 (optional)
XAI_API_KEY=

# Optional provider selection (gemini | openai | anthropic | xai)
LLM_PROVIDER=gemini
# Override model id (xAI default: grok-4.7 from current docs)
# LLM_MODEL=grok-4.7

# Backend URL (for generating pairing QR codes)
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Optional: Admin password for /api/auth/login (local fallback)
ADMIN_PASSWORD=admin

# AWS Cognito (shared by Netlify UI + APK). Leave empty for local JWT only.
COGNITO_REGION=eu-west-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Only these accounts can control devices on this instance
ALLOWED_USER_EMAILS=macandersonuche@yahoo.com,admin
