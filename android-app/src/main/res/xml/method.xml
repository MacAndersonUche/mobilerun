<?xml version="1.0" encoding="utf-8"?>
<!-- Samsung One UI hides IMEs that declare an empty <input-method/> with no
     <subtype>. Subtypes + settingsActivity are required for the keyboard to
     appear under Settings → General management → Keyboard list and default. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="ai.mobilerun.selfhosted.input.ImeSettingsActivity"
    android:isDefault="true"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/ime_subtype_en_gb"
        android:imeSubtypeLocale="en_GB"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />
    <subtype
        android:label="@string/ime_subtype_en_us"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />
</input-method>
